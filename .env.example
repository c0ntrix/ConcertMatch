# Copy to .env.local for local work. Never commit real credentials.
TICKETMASTER_API_KEY=
# Optional: approved Eventfrog Public API access, NOT an Organizer API key.
EVENTFROG_API_KEY=
# Optional Spotify top-artists import. Restricted to allowlisted users unless approved.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/spotify/callback
APP_ORIGIN=http://localhost:5173
